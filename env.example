# Copy to .env and fill in to run the stack against a real RTAC
# (see "Running Against a Real RTAC" in the README).  .env is git-ignored:
# keep hostnames, addresses and key paths out of the repository.

# The tinc network name, i.e. the directory under tinc's config dir
TINC_NETNAME=newtown

# SSH login for the machine that sits on the RTAC's network, by its VPN
# address: user@host
REAL_RTAC_SSH=

# Private key for that login.  Leave blank to use ssh's defaults.
REAL_RTAC_SSH_KEY=

# The RTAC's Modbus endpoint as that machine sees it: host:port
REAL_RTAC_TARGET=

# The RTAC's Modbus unit id
REAL_RTAC_SLAVE_ID=

# No need to change below here

# Local port the tunnel listens on
REAL_RTAC_LOCAL_PORT=5020

# Local address the tunnel listens on.  The default is right for Docker Desktop
# (macOS, Windows), where containers reach the host's loopback.  On Linux they
# can't: set this to the Docker bridge address instead (usually 172.17.0.1).
REAL_RTAC_BIND=127.0.0.1
